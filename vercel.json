{
  "version": 2,
  "public": true,
  "rewrites": [
    { "source": "/build/(.*)", "destination": "/build/$1" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ],
  "headers": [
    {
      "source": "/build/steganography.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ]
}
